# Copie este arquivo para .env e ajuste se precisar.

# --- Opção 1 (padrão): Ollama rodando local ---
# "emporio-qwen2.5" é o qwen2.5:7b com contexto maior, criado a partir do Modelfile
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=emporio-qwen2.5
LLM_API_KEY=ollama

# --- Opção 2: Groq (free tier) ---
# Crie uma chave gratuita em https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=sua_chave_aqui

# Opcional: data usada como "hoje" pelo agente (formato AAAA-MM-DD).
# Útil porque os dados de pedidos vão só até março/2026.
# DATA_REFERENCIA=2026-03-25
